    <!-- Adb -->
    <string name="dialog_adb_discovery">正在搜索无线调试服务</string>
    <string name="dialog_adb_discovery_message">请在“开发者选项”中启用“无线调试”。网络变化时，“无线调试”会被自动关闭。\n\n注意：请勿关闭“开发者选项”或“USB 调试”，否则 Porter 会停止运行。</string>
    <string name="dialog_adb_discovery_message_toggle_wireless_debugging">如果一直在搜索，请尝试关闭再重新启用“无线调试”。</string>
