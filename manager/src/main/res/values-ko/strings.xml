    <!-- Adb -->
    <string name="dialog_adb_discovery">무선 디버깅 서비스 검색 중</string>
    <string name="dialog_adb_discovery_message">\"개발자 옵션\"에서 \"무선 디버깅\"을 활성화하세요. 네트워크가 변경되면 \"무선 디버깅\"이 자동으로 비활성화됩니다.\n\n참고: \"개발자 옵션\"이나 \"USB 디버깅\"을 비활성화하지 마세요. 비활성화하면 Porter가 중지됩니다.</string>
    <string name="dialog_adb_discovery_message_toggle_wireless_debugging">\"무선 디버깅\"이 검색중으로 유지된다면
        비활성화했다가 다시 활성화해 보세요.</string>
    <string name="dialog_adb_port">포트 번호</string>
    <string name="adb_pairing">페어링</string>
    <string name="dialog_adb_pairing_title">기기와 페어링</string>
    <string name="dialog_adb_pairing_discovery">페어링 서비스 검색 중</string>
    <string name="dialog_adb_pairing_paring_code">페어링 코드</string>
    <string name="paring_code_is_wrong">페어링 코드가 올바르지 않습니다.</string>
    <string name="cannot_connect_port">무선 디버깅 서비스에 연결할 수 없습니다.\n\n네트워크 접근을 제한할 수 있는 모든 방화벽, 광고 차단, VPN 또는 유사한 앱에서 Porter가 허용 목록에 등록되어 있는지 확인하세요.</string>
    <string name="dialog_wireless_adb_not_enabled">무선 디버깅을 사용하고 있지 않습니다.
        \n안드로이드 11 이전은 무선 디버깅을 사용하기 위해서 컴퓨터 연결을 필수로 해야 합니다.</string>
    <string name="dialog_usb_debugging_not_enabled">USB 디버깅이 활성화되어 있지 않습니다.\n\"개발자 옵션\"에서 활성화해 주세요.</string>
    <string name="dialog_adb_pairing_accessibility_permission">Android 14에서 패키지 설치 프로그램으로 Porter를 설치/업데이트하면 페어링용 접근성 서비스를 활성화하는 데 필요한 ^1 권한이 취소됩니다.\n\n이 권한을 부여하려면 다음 ADB 명령을 실행하세요.\n\n^2\n\n명령을 실행한 후 페어링 과정을 계속할 수 있습니다.\n\n참고: ADB로 Porter를 설치/업데이트하면 이 문제를 피할 수 있습니다.</string>
    <string name="dialog_adb_pairing_accessibility_enable">페어링 과정을 시작하려면 접근성 서비스를 활성화하세요. 이렇게 하면 Porter가 페어링 코드를 감지할 수 있습니다.\n\n접근성 서비스는 페어링을 시도한 후, 또는 1분 이내에 코드를 찾지 못하면 꺼집니다. Porter가 결과를 표시하고 다시 시도할 수 있게 해 줍니다.</string>
    <string name="dialog_adb_pairing_accessibility_navigate">다음 단계에 따라 페어링을 시작하세요.\n- \"개발자 옵션\"으로 이동합니다.\n- \"USB 디버깅\" 및 \"무선 디버깅\"을 활성화합니다.\n- \"무선 디버깅\"의 왼쪽을 탭합니다.\n- \"페어링 코드로 기기 페어링\"을 탭합니다. Porter가 자동으로 페어링 코드를 감지합니다.</string>
    <string name="adb_pairing_requires_multi_window">먼저 화면 분할 (멀티 윈도우) 모드로 진입하세요.</string>
    <string name="adb_pairing_requires_multi_window_reason">시스템에서는 페어링 대화상자가 항상 표시되어야 합니다. 분할 화면 모드를 사용해야만 이 앱과 시스템 대화상자를 동시에 볼 수 있습니다.</string>
    <string name="adb_error_key_store">무선 디버깅용 키를 생성할 수 없습니다.\n이는 이 장치의 KeyStore 메커니즘이 고장 났기 때문일 수
        있습니다.</string>
    <string name="adb_pair_required">페어링 단계를 먼저 진행하세요.</string>
    <string name="enable">활성화</string>
    <string name="development_settings">개발자 옵션</string>
    <string name="notification_settings">알림 옵션</string>
    <string name="adb_pairing_tutorial_content_notification">Porter의 알림이 페어링 완료를 도와줍니다.</string>
    <string name="adb_pairing_tutorial_content_steps">\"개발자 옵션\"으로 이동한 다음 \"USB 디버깅\"과 \"무선 디버깅\"을
        활성화합니다.</string>
    <string name="adb_pairing_tutorial_content_enter_pairing_code">\"무선 디버깅\"의 왼쪽을 탭한 다음 \"페어링 코드로
        기기 페어링\"을 탭합니다. 알림에 있는 코드를 입력하여 페어링을 완료합니다.</string>
    <string name="adb_pairing_tutorial_content_notification_blocked">페어링 과정에서 Porter의 알림을 사용해야 합니다. Porter가 알림을 보낼 수 있도록 허용하세요.</string>
    <string name="adb_pairing_tutorial_content_miui">MIUI 사용자는 시스템 설정의 \"알림\" - \"알림 창\"에서 알림 스타일을
        \"Android\"로 전환해야 합니다.</string>
    <string name="adb_pairing_tutorial_content_miui_2">그렇지 않으면 알림에서 페어링 코드를 입력하지 못할 수도 있습니다.</string>
    <string name="adb_pairing_tutorial_content_finish">Porter로 돌아가서 Porter를 시작하세요.</string>
    <string name="adb_pairing_tutorial_content_network">Porter는 로컬 네트워크에 접근해야 합니다. 이는 네트워크 권한으로 제어됩니다.</string>
    <string name="adb_pairing_tutorial_content_network_limation_not_foreground">일부 시스템(예: MIUI)은 앱이 포그라운드 서비스를 사용하더라도 화면에 보이지 않으면 네트워크 접근을 허용하지 않습니다. 이러한 시스템에서는 Porter의 배터리 최적화 기능을 비활성화하세요.</string>
