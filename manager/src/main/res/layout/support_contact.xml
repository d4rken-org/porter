<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/porter_contact_summary" android:layout_marginBottom="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/contact_category" android:text="@string/porter_contact_category" />
        <Spinner android:id="@+id/contact_category" android:layout_width="match_parent"
            android:layout_height="48dp" android:entries="@array/porter_contact_categories" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/description_layout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/porter_contact_description" android:layout_marginTop="16dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contact_description" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine" android:minLines="4" android:maxLength="5000" android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/expected_layout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/porter_contact_expected" android:layout_marginTop="16dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contact_expected" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:maxLength="3000" android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:labelFor="@id/contact_attachment" android:text="@string/porter_contact_attachment" />
        <Spinner android:id="@+id/contact_attachment" android:layout_width="match_parent" android:layout_height="48dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/contact_record" android:layout_width="match_parent" android:layout_height="wrap_content"
            style="?attr/materialButtonOutlinedStyle" android:text="@string/porter_debug_start" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/porter_contact_privacy" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/contact_send" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/porter_contact_send" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
