fastlane_version "2.233.1"

default_platform :android

# Two upload lanes, no binary lane. Porter's releases are cut by .github/workflows/release-tag.yml
# and nothing in the repository holds Play credentials, so a beta/production lane would be
# untested scaffolding.
#
# Every skip_ flag is stated on both lanes. There is no "inverse of the other lane": inverting
# screenshots_only would turn skip_upload_apk/skip_upload_aab off and let a discovered binary
# upload itself.
platform :android do

  # Screenshots and nothing else. Icon, feature graphic, listing texts and changelogs are all
  # left as they are on the Console.
  lane :screenshots_only do
    supply(
      track: 'production',
      package_name: 'eu.darken.porter',
      skip_upload_apk: 'true',
      skip_upload_aab: 'true',
      skip_upload_metadata: 'true',
      skip_upload_changelogs: 'true',
      skip_upload_images: 'true',
      skip_upload_screenshots: 'false',
    )
  end

  # Listing texts (title, short and full description) and nothing else.
  #
  # Changelogs stay off: Porter's release notes are generated by release-tag.yml, and a lane that
  # silently republished them from fastlane/metadata would fight it.
  lane :listing_only do
    supply(
      track: 'production',
      package_name: 'eu.darken.porter',
      skip_upload_apk: 'true',
      skip_upload_aab: 'true',
      skip_upload_metadata: 'false',
      skip_upload_changelogs: 'true',
      skip_upload_images: 'true',
      skip_upload_screenshots: 'true',
    )
  end
end
