fastlane_version "2.233.1"

default_platform :android

# Play's API track names do not line up with the Console labels:
# internal = Internal testing, alpha = Closed testing, beta = Open testing, production = Production.
#
# Every skip_ flag is stated on every lane. There is no "inverse of the other lane": inverting
# screenshots_only would turn skip_upload_apk/skip_upload_aab off and let a discovered binary
# upload itself.
platform :android do

  # Uploads the bundle at PORTER_AAB. Porter is in closed testing, so -beta and -rc tags alike go to
  # 'alpha'; promotion happens in the Console. No rollout percentage: a staged rollout on a test
  # track leaves most testers on the previous build.
  lane :release do
    code = Integer(ENV.fetch('PORTER_VERSION_CODE'))
    # A re-run after a successful upload would otherwise fail on the already used version code.
    published = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(package_name: 'eu.darken.porter', track: track)
    end
    if published.include?(code)
      UI.important("Version code #{code} is already on Google Play, nothing to upload")
      next
    end
    supply(
      track: 'alpha',
      package_name: 'eu.darken.porter',
      aab: ENV.fetch('PORTER_AAB'),
      skip_upload_apk: 'true',
      skip_upload_aab: 'false',
      skip_upload_metadata: 'true',
      skip_upload_changelogs: 'false',
      skip_upload_images: 'true',
      skip_upload_screenshots: 'true',
    )
  end

  # Screenshots and nothing else. Icon, feature graphic, listing texts and changelogs are all
  # left as they are on the Console.
  lane :screenshots_only do
    supply(
      track: 'production',
      package_name: 'eu.darken.porter',
      skip_upload_apk: 'true',
      skip_upload_aab: 'true',
      skip_upload_metadata: 'true',
      skip_upload_changelogs: 'true',
      skip_upload_images: 'true',
      skip_upload_screenshots: 'false',
    )
  end

  # Listing texts (title, short and full description) and nothing else.
  #
  # Changelogs stay off: they belong to a release, which the release lane uploads with its bundle.
  lane :listing_only do
    supply(
      track: 'production',
      package_name: 'eu.darken.porter',
      skip_upload_apk: 'true',
      skip_upload_aab: 'true',
      skip_upload_metadata: 'false',
      skip_upload_changelogs: 'true',
      skip_upload_images: 'true',
      skip_upload_screenshots: 'true',
    )
  end
end
